                            android:layout_marginTop="2dp"
                            android:text="超过该长度则跳过识别"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
